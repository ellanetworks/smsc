  "description": "Monitor your Ella SMSC deployment: message traffic, delivery, SMPP, HSS and system load.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Service Status",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "description": "Short messages accepted per second, from phones, the API and SMPP, one per part.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "suffix: msg/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "editorMode": "code",
          "expr": "sum(rate(ellasmsc_messages_received_total{job=~\"$job\",instance=~\"$instance\",result=\"accepted\"}[$__rate_interval]))",
          "legendFormat": "Accepted",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Message Rate",
      "type": "stat",
      "id": 2
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "description": "Short messages delivered as a share of those that reached a final status (delivered, failed, expired) over the selected time range. Replaced messages are left out.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No attempts",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "unit": "percent",
          "noValue": "No attempts"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "editorMode": "code",
          "expr": "(\n  100 * (\n    sum(increase(ellasmsc_messages_completed_total{job=~\"$job\",instance=~\"$instance\",type=\"message\",status=\"delivered\"}[$__range]))\n    /\n    sum(increase(ellasmsc_messages_completed_total{job=~\"$job\",instance=~\"$instance\",type=\"message\",status=~\"delivered|failed|expired\"}[$__range]))\n  )\n  and\n  sum(increase(ellasmsc_messages_completed_total{job=~\"$job\",instance=~\"$instance\",type=\"message\",status=~\"delivered|failed|expired\"}[$__range])) > 0\n)\nor vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Delivery Success",
      "type": "stat",
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
